# Copy to .env.local and fill in. Never commit real values.

# Canonical site URL, used for metadata, sitemap and structured data.
NEXT_PUBLIC_SITE_URL=https://www.example.com

# Analytics (placeholder). When empty, events are only logged in development.
# Set to a Google Tag Manager container ID (GTM-XXXXXXX) to load GTM.
NEXT_PUBLIC_GTM_ID=

# Show small "TBC" markers next to placeholder claims, prices and certifications.
# Set to "false" before launch once copy has been verified.
NEXT_PUBLIC_SHOW_PLACEHOLDER_MARKERS=true

# Payment / shipping integrations (placeholders, server-side only, not yet wired).
# PAYMENT_PROVIDER_KEY_ID=
# PAYMENT_PROVIDER_KEY_SECRET=
# SHIPPING_PROVIDER_API_KEY=
